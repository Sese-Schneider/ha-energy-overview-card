{
  "name": "energy-overview-card",
  "version": "3.0.0",
  "description": "Lovelace energy-overview-card",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "module": "energy-overview-card.js",
  "repository": "https://github.com/Sese-Schneider/ha-energy-overview-card",
  "author": "Sebastian Schneider <sese.tailor@gmx.net>, Tim Laing <tim@laingcorp.co.uk>",
  "license": "MIT",
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "6.0.3",
    "esbuild": "0.28.2",
    "vitest": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "1.64.1"
  },
  "scripts": {
    "start": "node scripts/build.mjs --watch",
    "build": "npm run check && node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint src scripts test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run && vitest run --mode webkit",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "npm run build && vitest"
  },
  "homepage": "https://github.com/Sese-Schneider/ha-energy-overview-card",
  "bugs": {
    "url": "https://github.com/Sese-Schneider/ha-energy-overview-card/issues"
  },
  "private": true,
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Sese-Schneider"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/timlaing"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "type": "module"
}
